# Copy to `.dev.vars` (gitignored) for local `wrangler dev`.
# In production set these with `wrangler secret put <NAME>`.

# Session signing secret for better-auth (minimum 32 characters).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# HMAC/JWT secret for short-lived WebSocket connect tickets (minimum 32 characters).
# Generate a separate value with: openssl rand -base64 32
RT_TICKET_SECRET="replace-with-a-different-32-character-secret"
