# Copy to `apps/server/.env` (gitignored) for NON-INTERACTIVE wrangler auth
# (CI, scripts). For local dev, `wrangler login` is simpler and needs nothing here.
#
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# with the "Edit Cloudflare Workers" template (Workers Scripts, Workers KV, D1,
# Durable Objects, Workers Routes — Edit; Account Settings — Read).
#
# In CI these are GitHub Actions repo secrets, not a file.

CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# --- NOT here ---
# Worker RUNTIME secrets (AUTH_SECRET, RT_TICKET_SECRET, …) go in
# `apps/server/.dev.vars` for local dev (see .dev.vars.example) and are set in
# production with `wrangler secret put <NAME>`.
