{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordle-clash",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Production hostnames. Custom Domains make this Worker the origin and let
  // Cloudflare manage the DNS records and TLS certificates automatically.
  "routes": [
    { "pattern": "wordleclash.com", "custom_domain": true },
    { "pattern": "www.wordleclash.com", "custom_domain": true },
  ],

  // The single Worker also serves the built SPA. `vite build` in apps/web
  // produces ../web/dist; `wrangler deploy` from here ships assets + Worker +
  // Durable Object + D1 in one shot. SPA fallback lets /room/:code deep-link.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },

  // One Durable Object instance per room (addressed by room code).
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // Accounts / favorites / (inert) match history.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordle-clash",
      "database_id": "b67f0627-315b-4b7d-b7cc-40ee7864f68f",
      "migrations_dir": "migrations",
    },
  ],
}
